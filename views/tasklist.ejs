<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Tasks</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="page-wrapper">

        <!-- HERO -->

        <section class="hero-container task-hero">

            <img
                src="images/hero-bg2.jpg"
                class="hero-bg"
                alt="Task Dashboard"
            >

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <h1>

                    Manage Tasks.
                    <br>
                    Stay Productive.
                    <br>
                    Achieve More.

                </h1>

                <p>

                    Track, edit and organize all your
                    productivity tasks in one place.

                </p>

                <div class="hero-buttons">

                    <a
                        href="/add-task"
                        class="btn-primary-custom"
                    >

                        <i class="bi bi-plus-lg"></i>
                        Add Task

                    </a>

                </div>

            </div>

        </section>

        <!-- SEARCH & FILTER -->

        <section class="dashboard-card recent-task-card mb-4">

            <form
                action="/tasks"
                method="GET"
            >

                <div class="advanced-filter-grid">

                    <div class="modern-search">

                        <i class="bi bi-search"></i>

                        <input
                            type="text"
                            name="search"
                            value="<%= search %>"
                            placeholder="Search task name..."
                        >

                    </div>

                    <select
                        name="priority"
                        class="modern-select"
                    >

                        <option value="All">
                            All Priority
                        </option>

                        <option
                            value="High"
                            <%= priority === "High" ? "selected" : "" %>
                        >
                            High
                        </option>

                        <option
                            value="Medium"
                            <%= priority === "Medium" ? "selected" : "" %>
                        >
                            Medium
                        </option>

                        <option
                            value="Low"
                            <%= priority === "Low" ? "selected" : "" %>
                        >
                            Low
                        </option>

                    </select>

                    <select
                        name="status"
                        class="modern-select"
                    >

                        <option value="All">
                            All Status
                        </option>

                        <option
                            value="Pending"
                            <%= status === "Pending" ? "selected" : "" %>
                        >
                            Pending
                        </option>

                        <option
                            value="Completed"
                            <%= status === "Completed" ? "selected" : "" %>
                        >
                            Completed
                        </option>

                        <option
                            value="Overdue"
                            <%= status === "Overdue" ? "selected" : "" %>
                        >
                            Overdue
                        </option>

                    </select>

                    <input
                        type="date"
                        name="dueDate"
                        class="modern-date"
                        value="<%= dueDate %>"
                    >

                    <div class="filter-buttons">

                        <button
                            type="submit"
                            class="btn-filter btn-primary-custom"
                        >

                            <i class="bi bi-funnel-fill"></i>
                            Apply

                        </button>

                        <a
                            href="/tasks"
                            class="btn-reset"
                        >

                            Reset

                        </a>

                    </div>

                </div>

            </form>

        </section>

        <!-- TASK TABLE -->

        <section class="dashboard-card recent-task-card">

            <div class="section-header">

                <div>

                    <h2 class="section-title">

                        All Tasks

                    </h2>

                    <p class="section-subtitle">

                        <%= taskList.length %> tasks available

                    </p>

                </div>

            </div>

            <% if(taskList.length === 0){ %>

                <div class="empty-state-pro">

                    <div class="empty-icon">

                        <i class="bi bi-folder-x"></i>

                    </div>

                    <h3>
                        No Tasks Found
                    </h3>

                    <p>
                        Start by creating your first task.
                    </p>

                    <a
                        href="/add-task"
                        class="btn-primary-custom"
                    >

                        <i class="bi bi-plus-lg"></i>
                        Add Task

                    </a>

                </div>

            <% } else { %>

                <div class="recent-task-wrapper">

                    <table class="professional-table">

                        <thead>

                            <tr>

                                <th>Task</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th>Actions</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% taskList.forEach(task => { %>

                                <tr>

                                    <td>

                                        <div class="task-main">

                                            <div class="task-dot"></div>

                                            <div>

                                                <div class="task-title">
                                                    <%= task.title %>
                                                </div>

                                                <div class="task-description">
                                                    <%= task.description || "No description available" %>
                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="category-pill">
                                            <%= task.category || "General" %>
                                        </span>

                                    </td>

                                    <td>

                                        <span class="priority-pill <%= task.priority ? task.priority.toLowerCase() : 'default' %>">

                                            <%= task.priority || "None" %>

                                        </span>

                                    </td>

                                    <td>

                                        <span class="status-pill <%= task.status ? task.status.toLowerCase().replace(/\s+/g, '-') : 'default' %>">

                                            <%= task.status || "Unknown" %>

                                        </span>

                                    </td>

                                    <td>

                                        <span class="date-cell">

                                            <i class="bi bi-calendar3"></i>

                                            <%= task.dueDate || "No Date" %>

                                        </span>

                                    </td>

                                    <td>

                                        <div class="action-buttons">

                                            <a
                                                href="/task/<%= task.id %>"
                                                class="task-btn btn-view"
                                            >

                                                <i class="bi bi-eye"></i>
                                                View

                                            </a>

                                            <a
                                                href="/task/edit/<%= task.id %>"
                                                class="task-btn btn-edit"
                                            >

                                                <i class="bi bi-pencil-square"></i>
                                                Edit

                                            </a>

                                            <% if(task.status !== "Completed"){ %>

                                                <form
                                                    action="/task/complete/<%= task.id %>"
                                                    method="POST"
                                                >

                                                    <button
                                                        class="task-btn btn-complete"
                                                        type="submit"
                                                    >

                                                        <i class="bi bi-check-circle"></i>
                                                        Complete

                                                    </button>

                                                </form>

                                            <% } %>

                                            <form
                                                action="/task/delete/<%= task.id %>"
                                                method="POST"
                                            >

                                                <button
                                                    class="task-btn btn-delete"
                                                    type="submit"
                                                >

                                                    <i class="bi bi-trash3"></i>
                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>