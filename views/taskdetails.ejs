<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Task Details</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="page-wrapper">

        <!-- HEADER -->

        <section class="dashboard-card task-detail-header mb-4">

            <div class="task-detail-top">

                <div>

                    <span class="header-tag">

                        Task Details

                    </span>

                    <h1 class="task-detail-title">

                        <%= task.title %>

                    </h1>

                    <p class="section-subtitle">

                        View and manage your task
                        information professionally.

                    </p>

                </div>

                <span class="status-pill <%= task.status ? task.status.toLowerCase().replace(/\s+/g, '-') : 'default' %>">

                    <%= task.status || "Unknown" %>

                </span>

            </div>

        </section>

        <!-- MAIN CARD -->

        <section class="dashboard-card task-detail-card">

            <!-- DESCRIPTION -->

            <div class="detail-section">

                <div class="section-header mb-3">

                    <div>

                        <h2 class="section-title">

                            Description

                        </h2>

                        <p class="section-subtitle">

                            Task overview and notes.

                        </p>

                    </div>

                </div>

                <div class="description-box-pro">

                    <%= task.description || "No description added." %>

                </div>

            </div>

            <!-- INFO GRID -->

            <div class="details-grid-pro">

                <!-- CATEGORY -->

                <div class="info-card-pro">

                    <div class="info-icon-pro blue-bg">

                        <i class="bi bi-folder2-open"></i>

                    </div>

                    <h5>

                        Category

                    </h5>

                    <span class="category-pill">

                        <%= task.category || "General" %>

                    </span>

                </div>

                <!-- PRIORITY -->

                <div class="info-card-pro">

                    <div class="info-icon-pro orange-bg">

                        <i class="bi bi-flag"></i>

                    </div>

                    <h5>

                        Priority

                    </h5>

                    <span class="priority-pill <%= task.priority ? task.priority.toLowerCase() : 'default' %>">

                        <%= task.priority || "None" %>

                    </span>

                </div>

                <!-- DUE DATE -->

                <div class="info-card-pro">

                    <div class="info-icon-pro green-bg">

                        <i class="bi bi-calendar-event"></i>

                    </div>

                    <h5>

                        Due Date

                    </h5>

                    <div class="date-cell">

                        <%= task.dueDate || "No due date" %>

                    </div>

                </div>

            </div>

            <!-- BUTTONS -->

            <div class="task-buttons-pro">

                <!-- EDIT -->

                <a
                    href="/task/edit/<%= task.id %>"
                    class="task-action-btn btn-edit-task"
                >

                    <i class="bi bi-pencil-square"></i>

                    Edit Task

                </a>

                <!-- COMPLETE -->

                <% if(task.status !== "Completed"){ %>

                    <form
                        action="/task/complete/<%= task.id %>"
                        method="POST"
                    >

                        <button
                            class="task-action-btn btn-complete-task"
                            type="submit"
                        >

                            <i class="bi bi-check-circle"></i>

                            Complete

                        </button>

                    </form>

                <% } %>

                <!-- DELETE -->

                <form
                    action="/task/delete/<%= task.id %>"
                    method="POST"
                >

                    <button
                        class="task-action-btn btn-delete-task"
                        type="submit"
                    >

                        <i class="bi bi-trash3"></i>

                        Delete

                    </button>

                </form>

                <!-- BACK -->

                <a
                    href="/tasks"
                    class="task-action-btn btn-back-task"
                >

                    <i class="bi bi-arrow-left"></i>

                    Back

                </a>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>