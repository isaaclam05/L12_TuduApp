<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        <%= task ? "Edit Task" : "Add Task" %>

    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="container-custom">

        <!-- PAGE HEADER -->

        <section class="text-center mt-5 mb-5">

            <h1
                class="
                fw-bold
                mb-2
                "
                style="
                font-size:3rem;
                "
            >

                <%= task ? "Edit Task" : "Create New Task" %>

            </h1>

            <p class="text-secondary">

                <%= task
                ? "Update your task details."
                : "Organize your productivity and stay on track."
                %>

            </p>

        </section>

        <!-- FORM CARD -->

        <section
            class="
            card-ui
            p-5
            mx-auto
            "
            style="
            max-width:950px;
            "
        >

            <form

                action="<%= task ? `/task/edit/${task.id}` : '/add-task' %>"

                method="POST"
            >

                <!-- TITLE -->

                <div class="mb-4">

                    <label
                        class="
                        form-label
                        fw-semibold
                        mb-2
                        "
                    >

                        Task Title

                    </label>

                    <input
                        type="text"
                        name="title"
                        class="
                        form-control
                        modern-input
                        "
                        placeholder="Enter task title"
                        required
                        value="<%= task ? task.title : '' %>"
                    >

                </div>

                <!-- DESCRIPTION -->

                <div class="mb-4">

                    <label
                        class="
                        form-label
                        fw-semibold
                        mb-2
                        "
                    >

                        Description

                    </label>

                    <textarea
                        name="description"
                        rows="5"
                        class="
                        form-control
                        modern-input
                        "
                        placeholder="Describe your task"
                    ><%= task ? task.description : '' %></textarea>

                </div>

                <!-- ROW -->

                <div class="row g-4">

                    <!-- DATE -->

                    <div class="col-lg-4">

                        <label
                            class="
                            form-label
                            fw-semibold
                            mb-2
                            "
                        >

                            Due Date

                        </label>

                        <input
                            type="date"
                            name="dueDate"
                            class="
                            form-control
                            modern-input
                            "
                            value="<%= task ? task.dueDate : '' %>"
                        >

                    </div>

                    <!-- PRIORITY -->

                    <div class="col-lg-4">

                        <label
                            class="
                            form-label
                            fw-semibold
                            mb-2
                            "
                        >

                            Priority

                        </label>

                        <select
                            name="priority"
                            class="
                            form-select
                            modern-input
                            "
                        >

                            <option
                                value="Low"
                                <%= task?.priority === "Low" ? "selected" : "" %>
                            >

                                Low

                            </option>

                            <option
                                value="Medium"
                                <%= !task || task.priority === "Medium" ? "selected" : "" %>
                            >

                                Medium

                            </option>

                            <option
                                value="High"
                                <%= task?.priority === "High" ? "selected" : "" %>
                            >

                                High

                            </option>

                        </select>

                    </div>

                    <!-- CATEGORY -->

                    <div class="col-lg-4">

                        <label
                            class="
                            form-label
                            fw-semibold
                            mb-2
                            "
                        >

                            Category

                        </label>

                        <input
                            type="text"
                            name="category"
                            class="
                            form-control
                            modern-input
                            "
                            placeholder="e.g School"
                            value="<%= task ? task.category : '' %>"
                        >

                    </div>

                </div>

                <!-- BUTTONS -->

                <div
                    class="
                    d-flex
                    gap-3
                    mt-5
                    flex-wrap
                    "
                >

                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="
                        btn
                        add-btn
                        px-5
                        "
                    >

                        <%= task
                        ? "Update Task"
                        : "Create Task"
                        %>

                    </button>

                    <!-- CANCEL -->

                    <a
                        href="/tasks"
                        class="
                        btn
                        btn-light
                        rounded-4
                        px-4
                        "
                    >

                        Cancel

                    </a>

                </div>

            </form>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>
</html>