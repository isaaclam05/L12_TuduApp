<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>

        <%= task ? "Edit Task" : "Add Task" %>

    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="page-wrapper">

        <!-- HERO -->

        <section class="hero-container task-hero">

            <img
                src="images/hero-bg3.jpg"
                class="hero-bg"
                alt="Task Form"
            >

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <h1>

                    <%= task
                    ? "Edit Your Task."
                    : "Create New Task."
                    %>

                    <br>

                    Stay Organized.

                </h1>

                <p>

                    <%= task
                    ? "Update your task details professionally and stay on track."
                    : "Create and organize your tasks in one modern workspace."
                    %>

                </p>

                <div class="hero-buttons">

                    <a
                        href="/tasks"
                        class="btn-primary-custom"
                    >

                        <i class="bi bi-grid"></i>
                        View Tasks

                    </a>

                </div>

            </div>

        </section>

        <!-- FORM -->

        <section class="dashboard-card form-card-pro">

            <div class="section-header mb-4">

                <div>

                    <h2 class="section-title">

                        <%= task
                        ? "Edit Task"
                        : "Create Task"
                        %>

                    </h2>

                    <p class="section-subtitle">

                        Fill in the details below.

                    </p>

                </div>

            </div>

            <form
                action="<%= task ? `/task/edit/${task.id}` : '/add-task' %>"
                method="POST"
            >

                <!-- TITLE -->

                <div class="form-group-modern">

                    <label>

                        Task Title

                    </label>

                    <input
                        type="text"
                        name="title"
                        required
                        class="modern-input-pro"
                        placeholder="Enter task title"
                        value="<%= task ? task.title : '' %>"
                    >

                </div>

                <!-- DESCRIPTION -->

                <div class="form-group-modern">

                    <label>

                        Description

                    </label>

                    <textarea
                        name="description"
                        class="modern-input-pro modern-textarea"
                        placeholder="Describe your task"
                    ><%= task ? task.description : '' %></textarea>

                </div>

                <!-- GRID -->

                <div class="form-grid-pro">

                    <!-- DATE -->

                    <div class="form-group-modern">

                        <label>

                            Due Date

                        </label>

                        <input
                            type="date"
                            name="dueDate"
                            class="modern-input-pro"
                            value="<%= task ? task.dueDate : '' %>"
                        >

                    </div>

                    <!-- PRIORITY -->

                    <div class="form-group-modern">

                        <label>

                            Priority

                        </label>

                        <select
                            name="priority"
                            class="modern-input-pro"
                        >

                            <option
                                value="Low"
                                <%= task?.priority === "Low" ? "selected" : "" %>
                            >
                                Low
                            </option>

                            <option
                                value="Medium"
                                <%= !task || task.priority === "Medium" ? "selected" : "" %>
                            >
                                Medium
                            </option>

                            <option
                                value="High"
                                <%= task?.priority === "High" ? "selected" : "" %>
                            >
                                High
                            </option>

                        </select>

                    </div>

                    <!-- CATEGORY -->

                    <div class="form-group-modern">

                        <label>

                            Category

                        </label>

                        <input
                            type="text"
                            name="category"
                            class="modern-input-pro"
                            placeholder="e.g School"
                            value="<%= task ? task.category : '' %>"
                        >

                    </div>

                </div>

                <!-- BUTTONS -->

                <div class="task-buttons-pro">

                    <button
                        type="submit"
                        class="task-action-btn btn-create-task btn-primary-custom"
                    >

                        <i class="bi bi-check-circle"></i>

                        <%= task
                        ? "Update Task"
                        : "Create Task"
                        %>

                    </button>

                    <a
                        href="/tasks"
                        class="task-action-btn btn-cancel-task"
                    >

                        <i class="bi bi-arrow-left"></i>
                        Cancel

                    </a>

                </div>

            </form>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>

</html>