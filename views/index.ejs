<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Tudu Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="container-custom">

        <!-- HERO + STATS -->

        <section class="hero-section">

            <!-- LEFT HERO -->

            <div class="hero-card">

                <div class="hero-content">

                    <h1>
                        Stay Productive.
                        <br>
                        Stay Organized.
                    </h1>

                    <p>
                        Plan your day,
                        manage deadlines
                        and stay focused
                        with Tudu.
                    </p>

                    <div class="hero-buttons">

                        <a
                            href="/add-task"
                            class="
                            hero-btn
                            hero-btn-primary
                            "
                        >

                            + Add Task

                        </a>

                        <a
                            href="/tasks"
                            class="
                            hero-btn
                            hero-btn-outline
                            "
                        >

                            View Tasks

                        </a>

                    </div>

                </div>

                <img
                    src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                    width="230"
                    alt="task image"
                >

            </div>

            <!-- RIGHT STATS -->

            <div class="stats-grid">

                <!-- TOTAL -->

                <div class="stat-card">

                    <div
                        class="
                        stat-icon
                        blue-bg
                        "
                    >

                        <i class="bi bi-clipboard-check"></i>

                    </div>

                    <p>Total Tasks</p>

                    <h2>

                        <%= totalTasks %>

                    </h2>

                    <small
                        class="
                        text-secondary
                        "
                    >

                        All tasks created

                    </small>

                </div>

                <!-- COMPLETED -->

                <div class="stat-card">

                    <div
                        class="
                        stat-icon
                        green-bg
                        "
                    >

                        <i class="bi bi-check-circle"></i>

                    </div>

                    <p>Completed</p>

                    <h2>

                        <%= completedTasks %>

                    </h2>

                    <small
                        class="
                        text-secondary
                        "
                    >

                        Tasks completed

                    </small>

                </div>

                <!-- PENDING -->

                <div class="stat-card">

                    <div
                        class="
                        stat-icon
                        orange-bg
                        "
                    >

                        <i class="bi bi-clock"></i>

                    </div>

                    <p>Pending</p>

                    <h2>

                        <%= pendingTasks %>

                    </h2>

                    <small
                        class="
                        text-secondary
                        "
                    >

                        In progress

                    </small>

                </div>

                <!-- OVERDUE -->

                <div class="stat-card">

                    <div
                        class="
                        stat-icon
                        red-bg
                        "
                    >

                        <i class="bi bi-calendar-x"></i>

                    </div>

                    <p>Overdue</p>

                    <h2>

                        <%= overdueTasks %>

                    </h2>

                    <small
                        class="
                        text-secondary
                        "
                    >

                        Past due tasks

                    </small>

                </div>

            </div>

        </section>

        <!-- MAIN CONTENT -->

        <section class="main-grid">

            <!-- LEFT SIDE -->

            <div>

                <!-- QUICK ACTIONS -->

                <div class="card-ui">

                    <h3 class="fw-bold mb-4">
                        Quick Actions
                    </h3>

                    <a
                        href="/add-task"
                        class="
                        quick-action
                        text-decoration-none
                        text-dark
                        "
                    >

                        <div>

                            <h5>
                                Add New Task
                            </h5>

                            <small
                                class="
                                text-secondary
                                "
                            >
                                Create a task
                            </small>

                        </div>

                        <i
                            class="
                            bi
                            bi-chevron-right
                            "
                        ></i>

                    </a>

                    <a
                        href="/tasks"
                        class="
                        quick-action
                        text-decoration-none
                        text-dark
                        "
                    >

                        <div>

                            <h5>
                                View Tasks
                            </h5>

                            <small
                                class="
                                text-secondary
                                "
                            >
                                Manage all tasks
                            </small>

                        </div>

                        <i
                            class="
                            bi
                            bi-chevron-right
                            "
                        ></i>

                    </a>

                </div>

            </div>

            <!-- RIGHT SIDE -->

            <div class="card-ui">

                <div
                    class="
                    d-flex
                    justify-content-between
                    align-items-center
                    mb-4
                    "
                >

                    <h3 class="fw-bold">
                        Recent Tasks
                    </h3>

                    <a
                        href="/tasks"
                        class="
                        text-decoration-none
                        fw-semibold
                        "
                    >

                        View All →

                    </a>

                </div>

                <% if(taskList.length === 0){ %>

                <div
                    class="
                    text-center
                    py-5
                    "
                >

                    <h4>
                        No Tasks Yet
                    </h4>

                    <p
                        class="
                        text-secondary
                        "
                    >
                        Add your first task 🚀
                    </p>

                </div>

                <% } else { %>

                <table class="task-table">

                    <thead>

                        <tr>

                            <th>Task</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                    <% taskList.slice(0,5).forEach(task => { %>

                    <tr>

                        <!-- TASK -->

                        <td>

                            <div
                                class="
                                task-title
                                "
                            >

                                <%= task.title %>

                            </div>

                            <div
                                class="
                                task-description
                                "
                            >

                                <%= task.description || "No description" %>

                            </div>

                        </td>

                        <!-- CATEGORY -->

                        <td>

                            <span
                                class="
                                tag
                                blue-tag
                                "
                            >

                                <%= task.category %>

                            </span>

                        </td>

                        <!-- PRIORITY -->

                        <td>

                            <span
                                class="
                                priority
                                <%= task.priority.toLowerCase() %>
                                "
                            >

                                <%= task.priority %>

                            </span>

                        </td>

                        <!-- DATE -->

                        <td>

                            <%= task.dueDate || "No date" %>

                        </td>

                        <!-- STATUS -->

                        <td>

                            <span
                                class="
                                status
                                <%= task.status.toLowerCase() %>
                                "
                            >

                                <%= task.status %>

                            </span>

                        </td>

                        <!-- ACTION -->

                        <td>

                            <a
                                href="/task/<%= task.id %>"
                                class="
                                btn
                                view-btn
                                "
                            >

                                View

                            </a>

                        </td>

                    </tr>

                    <% }) %>

                    </tbody>

                </table>

                <% } %>

            </div>

        </section>

    </main>

    <%- include("partials/footer") %>

</body>
</html>