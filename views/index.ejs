<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="UTF-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Tudu</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <div class="container-fluid px-5 py-5">

        <div class="row g-5">

            <!-- LEFT BIG CARD -->
            <div class="col-lg-6">

                <div class="hero-card">

                    <div class="hero-overlay">

                        <h1>
                            Organize your tasks,
                            achieve your goals.
                        </h1>

                        <p>
                            Tudu helps you stay focused
                            and productive every day.
                        </p>

                        <a
                            href="/tasks"
                            class="
                            btn
                            gold-btn
                            "
                        >
                            <i
                                class="
                                bi
                                bi-rocket-takeoff
                                "
                            ></i>

                            Get Started
                        </a>

                    </div>

                </div>

            </div>

            <!-- RIGHT CARD -->
            <div class="col-lg-6">

                <div class="info-card">

                    <h2>
                        Plan Track
                        Complete
                    </h2>

                    <p>
                        Stay productive with Tudu.
                    </p>

                    <hr class="custom-line">

                    <div class="feature-item">

                        <div
                            class="
                            feature-icon
                            green
                            "
                        >
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div>
                            <h4>
                                Stay Organized
                            </h4>

                            <p>
                                Keep all your tasks
                                in one place.
                            </p>
                        </div>

                    </div>

                    <div class="feature-item">

                        <div
                            class="
                            feature-icon
                            blue
                            "
                        >
                            <i class="bi bi-clock"></i>
                        </div>

                        <div>
                            <h4>
                                Track Progress
                            </h4>

                            <p>
                                Monitor your
                                progress.
                            </p>
                        </div>

                    </div>

                    <div class="feature-item">

                        <div
                            class="
                            feature-icon
                            gold
                            "
                        >
                            <i class="bi bi-star"></i>
                        </div>

                        <div>
                            <h4>
                                Achieve More
                            </h4>

                            <p>
                                Get things done.
                            </p>
                        </div>

                    </div>

                    <div
                        class="
                        d-flex
                        gap-3
                        mt-5
                        "
                    >

                        <a
                            href="/tasks"
                            class="
                            btn
                            gold-btn
                            flex-fill
                            "
                        >
                            View Tasks
                        </a>

                        <a
                            href="/add-task"
                            class="
                            btn
                            dark-btn
                            flex-fill
                            "
                        >
                            Add Task
                        </a>

                    </div>

                </div>

            </div>

        </div>

        <!-- STATS SECTION -->
        <div class="row mt-5 g-4">

            <div class="col-lg-3">

                <div class="stat-card">

                    <i
                        class="
                        bi
                        bi-card-checklist
                        stat-icon
                        "
                    ></i>

                    <h2>
                        0
                    </h2>

                    <p>
                        Total Tasks
                    </p>

                </div>

            </div>

            <div class="col-lg-3">

                <div class="stat-card">

                    <i
                        class="
                        bi
                        bi-check-circle
                        stat-icon
                        "
                    ></i>

                    <h2>
                        0
                    </h2>

                    <p>
                        Completed
                    </p>

                </div>

            </div>

            <div class="col-lg-3">

                <div class="stat-card">

                    <i
                        class="
                        bi
                        bi-clock
                        stat-icon
                        "
                    ></i>

                    <h2>
                        0
                    </h2>

                    <p>
                        Pending
                    </p>

                </div>

            </div>

            <div class="col-lg-3">

                <div class="stat-card">

                    <i
                        class="
                        bi
                        bi-calendar-x
                        stat-icon
                        "
                    ></i>

                    <h2>
                        0
                    </h2>

                    <p>
                        Overdue
                    </p>

                </div>

            </div>

        </div>

    </div>

    <%- include("partials/footer") %>

</body>
</html>