<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Tudu Dashboard</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <link
        rel="stylesheet"
        href="/style.css"
    >

</head>

<body>

    <%- include("partials/navbar") %>

    <main class="page-wrapper">

        <!-- HERO -->

        <section class="hero-container">

            <img
                src="/images/hero-bg.jpg"
                class="hero-bg"
                alt="Task Dashboard"
            >

            <div class="hero-overlay"></div>

            <div class="hero-content">

                <h1>

                    Organize Tasks.
                    <br>
                    Track Progress.
                    <br>
                    Stay Ahead.

                </h1>

                <p>

                    Manage deadlines, priorities and progress
                    with a modern task tracking experience
                    built for productivity.

                </p>

                <div class="hero-buttons">

                    <a
                        href="/tasks"
                        class="btn-primary-custom"
                    >

                        <i class="bi bi-grid"></i>
                        View Tasks

                    </a>

                </div>

            </div>

        </section>

        <!-- STATS -->

        <section class="stats-section">

            <div class="stat-card">

                <div class="stat-icon blue-bg">

                    <i class="bi bi-list-check"></i>

                </div>

                <div>

                    <h5>Total Tasks</h5>

                    <h2>
                        <%= totalTasks %>
                    </h2>

                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon green-bg">

                    <i class="bi bi-check-circle"></i>

                </div>

                <div>

                    <h5>Completed</h5>

                    <h2>
                        <%= completedTasks %>
                    </h2>

                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon orange-bg">

                    <i class="bi bi-clock-history"></i>

                </div>

                <div>

                    <h5>Pending</h5>

                    <h2>
                        <%= pendingTasks %>
                    </h2>

                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon red-bg">

                    <i class="bi bi-exclamation-circle"></i>

                </div>

                <div>

                    <h5>Overdue</h5>

                    <h2>
                        <%= overdueTasks %>
                    </h2>

                </div>

            </div>

        </section>

        <!-- RECENT TASKS -->

        <section class="dashboard-card recent-task-card">

            <div class="section-header">

                <div>

                    <h2 class="section-title">

                        Recent Tasks

                    </h2>

                    <p class="section-subtitle">

                        Keep track of your latest activities
                        and upcoming deadlines.

                    </p>

                </div>

                <a
                    href="/tasks"
                    class="view-all-btn btn-primary-custom"
                >

                    View All Tasks

                    <i class="bi bi-arrow-right"></i>

                </a>

            </div>

            <%
                const latestTasks = [...taskList]
                    .sort((a, b) => {
                        return new Date(b.createdAt || b.id) - new Date(a.createdAt || a.id);
                    })
                    .slice(0, 5);
            %>

            <% if (latestTasks.length === 0) { %>

                <div class="empty-state-pro">

                    <div class="empty-icon">

                        <i class="bi bi-folder2-open"></i>

                    </div>

                    <h3>

                        No Tasks Yet

                    </h3>

                    <p>

                        Start organizing your work
                        by creating your first task.

                    </p>

                    <a
                        href="/add-task"
                        class="btn-primary-custom"
                    >

                        <i class="bi bi-plus-lg"></i>

                        Create Task

                    </a>

                </div>

            <% } else { %>

                <div class="recent-task-wrapper">

                    <table class="professional-table">

                        <thead>

                            <tr>

                                <th>Task</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Due Date</th>
                                <th>Action</th>

                            </tr>

                        </thead>

                        <tbody>

                            <% latestTasks.forEach(task => { %>

                                <tr>

                                    <td>

                                        <div class="task-main">

                                            <div class="task-dot"></div>

                                            <div>

                                                <div class="task-title">

                                                    <%= task.title %>

                                                </div>

                                                <div class="task-description">

                                                    <%= task.description || "No description available" %>

                                                </div>

                                            </div>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="category-pill">

                                            <%= task.category || "General" %>

                                        </span>

                                    </td>

                                    <td>

                                        <span class="priority-pill <%= task.priority ? task.priority.toLowerCase() : 'default' %>">

                                            <%= task.priority || 'None' %>

                                        </span>

                                    </td>

                                    <td>

                                        <span class="status-pill <%= task.status ? task.status.toLowerCase().replace(/\s+/g, '-') : 'default' %>">

                                            <%= task.status || "Unknown" %>

                                        </span>

                                    </td>

                                    <td>

                                        <%
                                            const dueDate = task.dueDate
                                                ? new Date(task.dueDate)
                                                : null;

                                            let dueClass = "normal";

                                            if (!dueDate) {

                                                dueClass = "no-date";

                                            } else {

                                                const cleanToday = new Date();
                                                cleanToday.setHours(0, 0, 0, 0);

                                                dueDate.setHours(0, 0, 0, 0);

                                                if (dueDate < cleanToday) {

                                                    dueClass = "overdue";

                                                } else if (
                                                    dueDate.getTime() === cleanToday.getTime()
                                                ) {

                                                    dueClass = "pending";

                                                }

                                            }
                                        %>

                                        <span class="date-cell <%= dueClass %>">

                                            <i class="bi bi-calendar3"></i>

                                            <%= task.dueDate || "No Date" %>

                                        </span>

                                    </td>

                                    <td>

                                        <a
                                            href="/task/<%= task.id %>"
                                            class="view-btn"
                                        >

                                            View

                                        </a>

                                    </td>

                                </tr>

                            <% }) %>

                        </tbody>

                    </table>

                </div>

            <% } %>

        </section>

    </main>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>